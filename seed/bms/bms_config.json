{
  "bms_system": {
    "system_id": "CASCADE-BMS-01",
    "protocol": "BACnet/IP",
    "site_name": "Cascade Tower",
    "firmware_version": "4.2.1",
    "last_calibration": "2024-01-15",
    "network_switch": "SW-03",
    "polling_interval_sec": 15,
    "export": {
      "enabled": true,
      "output_file": "COOLFLAG.DAT",
      "format": "FIXED_80",
      "schedule": "DAILY_0200",
      "description": "Exports cooling system status flags for lease billing SLA credit processing. Each record contains unit ID, cooling OK/FAIL status, timestamp, and outage duration in minutes.",
      "record_layout": {
        "unit_id": { "start": 1, "length": 8 },
        "status": { "start": 9, "length": 1, "values": ["Y", "N"] },
        "timestamp": { "start": 10, "length": 19, "format": "YYYY-MM-DD HH:MM:SS" },
        "duration_min": { "start": 29, "length": 4, "format": "9999" },
        "detail": { "start": 33, "length": 48 }
      }
    }
  },

