//INVBATCH JOB (ACCT),'MONTHLY INVOICE BATCH',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,TIME=(,30)
//*
//*****************************************************************
//* INVBATCH - NIGHTLY INVOICE BATCH PROCESSING
//* RUN SCHEDULE: DAILY 02:00 AM EST
//* DEPENDENCIES: LEASE MASTER FILE, COOLFLAG.DAT (BMS EXPORT)
//*
//* CHANGE LOG:
//*   2023-01-15 - ADDED BMS EXPORT STEP
//*   2018-09-14 - ADDED SLA CREDIT PROCESSING
//*   2017-06-15 - INITIAL RELEASE
//*
//* NOTE: STEP010 (LEASEBIL) RUNS BEFORE STEP020 (BMS EXPORT)
//*       THIS MEANS LEASEBIL READS THE PREVIOUS DAY'S COOLFLAG.DAT
//*       RATHER THAN THE CURRENT DAY'S STATUS
//*       SEE: TICKET OPS-2023-1142 (UNRESOLVED)
//*****************************************************************
//*
//*------- STEP 005: BACKUP PRIOR INVOICES -----------------------
//*
//STEP005  EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=PROD.LEASE.INVOICES,DISP=SHR
//SYSUT2   DD  DSN=PROD.LEASE.INVOICES.BACKUP,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(50,10),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//*
//*------- STEP 010: MONTHLY BILLING (LEASEBIL) -----------------
//*       READS COOLFLAG.DAT FOR SLA CREDIT PROCESSING
//*       ** COOLFLAG.DAT CONTAINS YESTERDAY'S STATUS **
//*
//STEP010  EXEC PGM=LEASEBIL,REGION=0M
//STEPLIB  DD  DSN=PROD.LEASE.LOADLIB,DISP=SHR
//LEASEMST DD  DSN=PROD.LEASE.MASTER,DISP=SHR
//COOLSTAT DD  DSN=PROD.BMS.COOLFLAG.DAT,DISP=SHR
//INVOUT   DD  DSN=PROD.LEASE.INVOICES,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(100,20),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//BILRPT   DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*------- STEP 015: SORT INVOICES BY TENANT --------------------
//*
//STEP015  EXEC PGM=SORT
//SORTIN   DD  DSN=PROD.LEASE.INVOICES,DISP=SHR
//SORTOUT  DD  DSN=PROD.LEASE.INVOICES.SORTED,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(100,20),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD  *
  SORT FIELDS=(1,10,CH,A)
/*
//SYSOUT   DD  SYSOUT=*
//*
//*------- STEP 020: BMS EXPORT (COOLFLAG.DAT) ------------------
//*       EXPORTS CURRENT COOLING STATUS FROM BMS
//*       ** THIS RUNS AFTER LEASEBIL HAS ALREADY READ THE OLD FILE **
//*
//STEP020  EXEC PGM=BMSEXPORT,REGION=0M
//STEPLIB  DD  DSN=PROD.BMS.LOADLIB,DISP=SHR
//BMSCFG   DD  DSN=PROD.BMS.CONFIG,DISP=SHR
//COOLOUT  DD  DSN=PROD.BMS.COOLFLAG.DAT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(5,1),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//*
//*------- STEP 025: INVOICE PRINT -------------------------------
//*
//STEP025  EXEC PGM=INVPRINT
//STEPLIB  DD  DSN=PROD.LEASE.LOADLIB,DISP=SHR
//INVIN    DD  DSN=PROD.LEASE.INVOICES.SORTED,DISP=SHR
//PRTOUT   DD  SYSOUT=A,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//SYSOUT   DD  SYSOUT=*
//*
//*------- STEP 030: FTP INVOICES TO ACCOUNTING -----------------
//*
//STEP030  EXEC PGM=FTP,PARM='(EXIT'
//INPUT    DD  *
  ACCTSVR.INTERNAL.NET
  PUT PROD.LEASE.INVOICES.SORTED INVOICES.DAT
  QUIT
/*
//OUTPUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//*
