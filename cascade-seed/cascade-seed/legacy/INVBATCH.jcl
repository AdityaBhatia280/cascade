//INVBATCH JOB (PROP001),'NIGHTLY INVOICES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*********************************************************************
//* NIGHTLY TENANT INVOICE RUN                                        *
//* SCHEDULED BY CONTROL-M JOB INV01 AT 01:00 DAILY                   *
//* COOLFLAG IS REFRESHED BY BMS EXPORT JOB BMSEXP (SEE FACILITIES)   *
//*********************************************************************
//STEP010  EXEC PGM=LEASEBIL
//STEPLIB  DD DSN=PROP.LOADLIB,DISP=SHR
//LEASEIN  DD DSN=PROP.LEASE.MASTER,DISP=SHR
//COOLFLAG DD DSN=FAC.BMS.COOLFLAG,DISP=SHR
//INVOICE  DD DSN=PROP.INVOICE.DAILY(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(50,10)),DCB=(RECFM=FB,LRECL=100)
//*
//STEP020  EXEC PGM=INVPOST,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=PROP.LOADLIB,DISP=SHR
//INVOICE  DD DSN=PROP.INVOICE.DAILY(0),DISP=SHR
//GLFEED   DD DSN=FIN.GL.FEED,DISP=MOD
//*
//* OLD BACKUP STEP, DISABLED 2015. COOLFLAG.BAK NO LONGER WRITTEN.
//*STEP030 EXEC PGM=IEBGENER
//*SYSUT1  DD DSN=FAC.BMS.COOLFLAG.BAK,DISP=SHR
