PORT=5001
# Site to serve: seed/sites/<CASCADE_SITE>. Its event log lives in data/<CASCADE_SITE>/events.jsonl.
CASCADE_SITE=dfw1
# Where event logs live (default: data/ at the repo root).
CASCADE_DATA_DIR=data
# 1: register no seed documents at boot, so the site holds only what is uploaded (empty on a fresh data dir).
CASCADE_START_EMPTY=
# Comma-separated browser origins allowed to call the API (Vite dev server by default).
CASCADE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM for the companion and for uploads (OpenAI-compatible chat completions with tools). Without a key
# the companion answers from a fixed intent table, and uploads are classified and read by the parsers.
LLM_API_KEY=
# NVIDIA_API_KEY is accepted instead of LLM_API_KEY.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Email for approved customer notices and handoff briefs (Resend REST API). Sending needs all three.
# Demo safety: every email goes to NOTIFY_TO, whoever it is for; the body names the intended recipient.
# Without them nothing is sent: each approved message is written to data/<CASCADE_SITE>/outbox/*.eml
# and reported "not sent".
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Cascade <cascade@yourdomain.example>
NOTIFY_FROM=
# The single demo inbox that receives every email.
NOTIFY_TO=
